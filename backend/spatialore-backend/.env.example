# Express Server Listening Port
PORT=3001

# Must match the DEPLOYED dashboard URL in production (e.g., https://spatialore-dashboard.netlify.app), NOT localhost.
ALLOWED_ORIGIN=http://localhost:5173

# Primary: Self-Hosted LLM (vLLM / Ollama)
# NOTE: In production, must be a publicly accessible URL/tunnel (e.g. ngrok/Tailscale), NOT localhost
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=not-needed-for-local-but-required-by-sdk
LLM_MODEL_NAME=llama-3-8b-instruct

# Fallback: Groq Cloud API (Free-tier)
GROQ_API_KEY=gsk_your_groq_api_key_from_console_groq_com
GROQ_MODEL_NAME=llama-3.1-8b-instant
