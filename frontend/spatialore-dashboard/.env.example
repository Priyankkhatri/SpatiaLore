# Supabase URL for your project
VITE_SUPABASE_URL=https://your-supabase-project-ref.supabase.co

# Supabase Anonymous Public Key (Safe for client bundle, protected by RLS)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Must point to the DEPLOYED backend URL in production (e.g. https://spatialore-backend.onrender.com), NOT localhost.
# Update this in Netlify / Vercel Site Settings -> Environment Variables, then rebuild the deployment.
VITE_BACKEND_URL=http://localhost:3001
