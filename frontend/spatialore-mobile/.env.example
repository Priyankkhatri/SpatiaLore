# Supabase Project URL for mobile app client
EXPO_PUBLIC_SUPABASE_URL=https://your-supabase-project-ref.supabase.co

# Supabase Anonymous Public Key (Safe for mobile bundle, read-only via RLS)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Points to the deployed spatialore-backend URL. For physical-device local testing, use your machine's local network IP, not localhost — a physical device cannot reach localhost on your dev machine.
EXPO_PUBLIC_BACKEND_URL=http://localhost:3001
